<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Crosscheck.Bridge.SimConnect</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <MsfsSdkDir>$([MSBuild]::EnsureTrailingSlash('$(MSFS2024_SDK)'))</MsfsSdkDir>
    <SimConnectLibDir>$(MsfsSdkDir)SimConnect SDK\lib\</SimConnectLibDir>
  </PropertyGroup>

  <!-- Needs the MSFS 2024 SDK (MSFS2024_SDK environment variable), like the spikes. -->
  <ItemGroup>
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>$(SimConnectLibDir)managed\Microsoft.FlightSimulator.SimConnect.dll</HintPath>
    </Reference>
    <None Include="$(SimConnectLibDir)SimConnect.dll" Link="SimConnect.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Crosscheck.Bridge.Core\Crosscheck.Bridge.Core.csproj" />
  </ItemGroup>

  <Target Name="CheckMsfsSdk" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(MSFS2024_SDK)' == ''" Text="MSFS2024_SDK environment variable is not set. Install the MSFS 2024 SDK (see bridge/README.md)." />
    <Error Condition="!Exists('$(SimConnectLibDir)SimConnect.dll')" Text="SimConnect.dll not found under $(SimConnectLibDir)" />
  </Target>

</Project>
