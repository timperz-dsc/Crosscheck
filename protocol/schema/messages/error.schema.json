{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crosscheck/protocol/v1/messages/error.schema.json",
  "title": "error",
  "description": "A message could not be processed. (server to client)",
  "type": "object",
  "$ref": "../common.schema.json#/$defs/envelope",
  "properties": {
    "type": {
      "const": "error"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "invalid_json",
            "invalid_message",
            "unsupported_version",
            "not_in_session",
            "bad_command",
            "resume_failed",
            "forbidden"
          ]
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "unevaluatedProperties": false
}
