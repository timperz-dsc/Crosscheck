<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>crosscheck</AssemblyName>
    <RootNamespace>Crosscheck.Bridge.App</RootNamespace>
    <Version>0.1.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep its namespaces out of the rest of the code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- The built UI (npm run build in ui/) is served by the local API from wwwroot. -->
  <ItemGroup Condition="Exists('..\..\ui\dist\index.html')">
    <Content Include="..\..\ui\dist\**\*" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Shipped next to the exe: the default server (not in code) and the Fenix profile. -->
  <ItemGroup>
    <Content Include="defaults.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\profiles\fenix-a320\profile.yaml" Link="profiles\fenix-a320\profile.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <!-- The WebView2 package always references its WPF control too; the app window is WinForms. -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Crosscheck.Bridge.Core\Crosscheck.Bridge.Core.csproj" />
    <ProjectReference Include="..\Crosscheck.Bridge.SimConnect\Crosscheck.Bridge.SimConnect.csproj" />
  </ItemGroup>

</Project>
