<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Crosscheck.Bridge.SimConnect</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <!-- With the MSFS 2024 SDK (MSFS2024_SDK environment variable) the DLLs come from it; otherwise
       from the copies in bridge/third_party/simconnect (Microsoft's files, see its README), so CI builds too. -->
  <PropertyGroup Condition="'$(MSFS2024_SDK)' != ''">
    <MsfsSdkDir>$([MSBuild]::EnsureTrailingSlash('$(MSFS2024_SDK)'))</MsfsSdkDir>
    <SimConnectNativeDir>$(MsfsSdkDir)SimConnect SDK\lib\</SimConnectNativeDir>
    <SimConnectManagedDir>$(MsfsSdkDir)SimConnect SDK\lib\managed\</SimConnectManagedDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSFS2024_SDK)' == ''">
    <SimConnectNativeDir>$(MSBuildThisFileDirectory)..\third_party\simconnect\</SimConnectNativeDir>
    <SimConnectManagedDir>$(MSBuildThisFileDirectory)..\third_party\simconnect\</SimConnectManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>$(SimConnectManagedDir)Microsoft.FlightSimulator.SimConnect.dll</HintPath>
    </Reference>
    <None Include="$(SimConnectNativeDir)SimConnect.dll" Link="SimConnect.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Crosscheck.Bridge.Core\Crosscheck.Bridge.Core.csproj" />
  </ItemGroup>

  <Target Name="CheckMsfsSdk" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(SimConnectNativeDir)SimConnect.dll')" Text="SimConnect.dll not found under $(SimConnectNativeDir)" />
    <Error Condition="!Exists('$(SimConnectManagedDir)Microsoft.FlightSimulator.SimConnect.dll')" Text="Microsoft.FlightSimulator.SimConnect.dll not found under $(SimConnectManagedDir)" />
  </Target>

</Project>
