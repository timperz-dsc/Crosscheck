{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crosscheck/protocol/v1/messages/snapshot_values.schema.json",
  "title": "snapshot_values",
  "description": "Values of one group, answer to snapshot_request. One message per group. (client to server)",
  "type": "object",
  "$ref": "../common.schema.json#/$defs/envelope",
  "properties": {
    "type": {
      "const": "snapshot_values"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "group",
        "values"
      ],
      "properties": {
        "request_id": {
          "$ref": "../common.schema.json#/$defs/id"
        },
        "group": {
          "$ref": "../common.schema.json#/$defs/group"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "var",
              "class",
              "value"
            ],
            "properties": {
              "var": {
                "$ref": "../common.schema.json#/$defs/varName"
              },
              "class": {
                "$ref": "../common.schema.json#/$defs/snapshotClass"
              },
              "value": {
                "$ref": "../common.schema.json#/$defs/scalar"
              },
              "step": {
                "description": "Owned values only: a drift change smaller than this is sent at most every 10 s.",
                "type": "number",
                "exclusiveMinimum": 0
              },
              "button": {
                "description": "Toggle items only: the edge push button whose lamp this is.",
                "$ref": "../common.schema.json#/$defs/varName"
              },
              "message": {
                "description": "Mode items only: what the pilots see when it differs.",
                "type": "string",
                "minLength": 1
              },
              "context": {
                "description": "Delta items with compare_when: 'unpowered' while the unit is off (value null), else the values of its mode vars; the display is compared only when both sides report the same context. Toggle and mode items with a power flag: 'unpowered' while the unit is off (value null), not compared then.",
                "type": "string",
                "maxLength": 400
              },
              "report_as": {
                "description": "Mode items only: show the difference under this control (several indicators of one knob give one line).",
                "$ref": "../common.schema.json#/$defs/varName"
              },
              "values": {
                "description": "Verified items: the profile's allowed values. The server never sends a correction to any other value (CRO-40).",
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": { "type": "number" }
              },
              "range": {
                "description": "Verified and analog items: the profile's allowed range [min, max]. The server never sends a correction outside it (CRO-40).",
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "number" }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "class": {
                      "const": "toggle"
                    }
                  }
                },
                "then": {
                  "required": [
                    "button"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "button"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "class": {
                      "const": "mode"
                    }
                  }
                },
                "then": {
                  "required": [
                    "message"
                  ]
                },
                "else": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "message"
                        ]
                      },
                      {
                        "required": [
                          "report_as"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "unevaluatedProperties": false
}
