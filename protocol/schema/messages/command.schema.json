{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crosscheck/protocol/v1/messages/command.schema.json",
  "title": "command",
  "description": "A pilot changed something. Client to server: without origin/attempt. Server to receiver: same body plus origin and attempt; envelope seq is the global order of the command. (both directions)",
  "type": "object",
  "$ref": "../common.schema.json#/$defs/envelope",
  "properties": {
    "type": {
      "const": "command"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "var",
        "class",
        "group",
        "settle_ms"
      ],
      "properties": {
        "id": {
          "$ref": "../common.schema.json#/$defs/id"
        },
        "var": {
          "$ref": "../common.schema.json#/$defs/varName"
        },
        "class": {
          "$ref": "../common.schema.json#/$defs/commandClass"
        },
        "value": {
          "description": "Absolute value (verified, analog, owned). For pulse: 1 for a press (an edge button's down), 0 for an edge button's up. The receiver of an edge never writes this number: it writes its own value + 1.",
          "type": "number"
        },
        "delta": {
          "description": "Only for class delta: the change. Never an absolute value.",
          "type": "number",
          "not": {
            "const": 0
          }
        },
        "group": {
          "$ref": "../common.schema.json#/$defs/group"
        },
        "settle_ms": {
          "$ref": "../common.schema.json#/$defs/settleMs"
        },
        "origin": {
          "description": "Set by the server when relaying.",
          "$ref": "../common.schema.json#/$defs/origin"
        },
        "attempt": {
          "description": "Set by the server: 0 for the first send, 1..3 for re-sends.",
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "edge": {
          "description": "Pulse with press edge (Fenix push buttons, which count +1 on press and +1 on release): down or up. Each edge is its own command.",
          "enum": [
            "down",
            "up"
          ]
        },
        "gap_ms": {
          "description": "With edge: the sender's time since the previous edge of this button. The receiver writes an up no sooner than max(50 ms, gap_ms) after its down.",
          "type": "integer",
          "minimum": 0
        },
        "effect": {
          "description": "Pulse only (for an edge button: down only): compare this effect var between the two sims after settle (the sender reports its own value with effect_report). same: equal values; parity: equal odd/even.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "var",
            "expect"
          ],
          "properties": {
            "var": {
              "$ref": "../common.schema.json#/$defs/varName"
            },
            "expect": {
              "enum": [
                "same",
                "parity"
              ]
            }
          }
        }
      },
      "dependentRequired": {
        "edge": [
          "gap_ms"
        ],
        "gap_ms": [
          "edge"
        ]
      },
      "allOf": [
        {
          "if": {
            "required": [
              "edge"
            ]
          },
          "then": {
            "properties": {
              "class": {
                "const": "pulse"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "const": "delta"
              }
            }
          },
          "then": {
            "required": [
              "delta"
            ],
            "not": {
              "required": [
                "value"
              ]
            }
          },
          "else": {
            "required": [
              "value"
            ],
            "not": {
              "required": [
                "delta"
              ]
            }
          }
        }
      ]
    }
  },
  "unevaluatedProperties": false
}
