{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crosscheck/protocol/v1/messages/control_denied.schema.json",
  "title": "control_denied",
  "description": "A control_request or control_give was refused. Snapshot differences never refuse a transfer. (server to client)",
  "type": "object",
  "$ref": "../common.schema.json#/$defs/envelope",
  "properties": {
    "type": {
      "const": "control_denied"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "desyncs",
        "message"
      ],
      "properties": {
        "reason": {
          "description": "peer_lost: the other pilot is not connected (a take can confirm @peer_lost, a give cannot). already_pf: take while PF. not_pf: give while PM. handover_in_progress: a handover is running.",
          "enum": [
            "peer_lost",
            "already_pf",
            "not_pf",
            "handover_in_progress"
          ]
        },
        "desyncs": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/activeDesync"
          }
        },
        "message": {
          "type": "string"
        }
      }
    }
  },
  "unevaluatedProperties": false
}
