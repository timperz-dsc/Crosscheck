<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Crosscheck.Bridge</RootNamespace>
    <Version>0.6.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same schema files the server validates against. -->
    <EmbeddedResource Include="..\..\protocol\schema\**\*.json" LogicalName="protocol-schema/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="JsonSchema.Net" Version="9.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Crosscheck.Profiles\Crosscheck.Profiles.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Crosscheck.Bridge.Tests" />
  </ItemGroup>

</Project>
