{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crosscheck/protocol/v1/messages/control_request.schema.json",
  "title": "control_request",
  "description": "\"I have control.\" From the pilot monitoring; granted immediately. confirm: [\"@peer_lost\"] is only needed when the pilot flying is not connected. (client to server)",
  "type": "object",
  "$ref": "../common.schema.json#/$defs/envelope",
  "properties": {
    "type": {
      "const": "control_request"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "confirm": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/controlConfirm"
          },
          "uniqueItems": true
        }
      }
    }
  },
  "unevaluatedProperties": false
}
