{
  "name": "crosscheck-server",
  "version": "0.2.0",
  "description": "Crosscheck session server: relays and verifies changes between two pilots (protocol v4).",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.6",
    "ajv": "^8.20.0",
    "fastify": "^5.12.7",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
