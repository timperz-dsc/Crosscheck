{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crosscheck/protocol/v1/messages/join.schema.json",
  "title": "join",
  "description": "Join a session with its join code (case-insensitive). The preflight is compared with the session reference. (client to server)",
  "type": "object",
  "$ref": "../common.schema.json#/$defs/envelope",
  "properties": {
    "type": {
      "const": "join"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "join_code",
        "preflight"
      ],
      "properties": {
        "join_code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{6}$"
        },
        "preflight": {
          "$ref": "../common.schema.json#/$defs/preflight"
        },
        "name": {
          "$ref": "../common.schema.json#/$defs/name"
        }
      }
    }
  },
  "unevaluatedProperties": false
}
