{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crosscheck/protocol/v1/messages/ping.schema.json",
  "title": "ping",
  "description": "Heartbeat, every heartbeat_ms in both directions. rtt_ms is the last round trip the sender measured. (both directions)",
  "type": "object",
  "$ref": "../common.schema.json#/$defs/envelope",
  "properties": {
    "type": {
      "const": "ping"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nonce",
        "t",
        "rtt_ms"
      ],
      "properties": {
        "nonce": {
          "type": "integer",
          "minimum": 0
        },
        "t": {
          "type": "number"
        },
        "rtt_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  },
  "unevaluatedProperties": false
}
