{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crosscheck/protocol/v1/messages/control_ack.schema.json",
  "title": "control_ack",
  "description": "The client applied control_changed (follower/flying mode switched). (client to server)",
  "type": "object",
  "$ref": "../common.schema.json#/$defs/envelope",
  "properties": {
    "type": {
      "const": "control_ack"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch"
      ],
      "properties": {
        "epoch": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "unevaluatedProperties": false
}
