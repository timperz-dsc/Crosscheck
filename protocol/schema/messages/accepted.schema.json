{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crosscheck/protocol/v1/messages/accepted.schema.json",
  "title": "accepted",
  "description": "The server logged a command. envelope.seq is the seq the command got. duplicate is true when the id was already logged (resend after reconnect). (server to client)",
  "type": "object",
  "$ref": "../common.schema.json#/$defs/envelope",
  "properties": {
    "type": {
      "const": "accepted"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "../common.schema.json#/$defs/id"
        },
        "duplicate": {
          "type": "boolean"
        }
      }
    }
  },
  "unevaluatedProperties": false
}
